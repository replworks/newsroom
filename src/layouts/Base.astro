---
interface Props {
  title: string;
  og?: { title: string; description: string; url: string };
}

const { title, og } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {og && (
      <>
        <meta name="description" content={og.description} />
        <meta property="og:type" content="article" />
        <meta property="og:title" content={og.title} />
        <meta property="og:description" content={og.description} />
        <meta property="og:url" content={og.url} />
        <link rel="canonical" href={og.url} />
      </>
    )}
    <style is:inline>
      :root {
        --ink: #1d1d1f;
        --muted: #6e6e73;
        --faint: #86868b;
        --rule: #d2d2d7;
        --wash: #f5f5f7;
        --paper: #ffffff;
        color-scheme: light;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0 auto;
        max-width: 980px;
        padding: 72px 22px 120px;
        background: var(--paper);
        color: var(--ink);
        font-family:
          -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue",
          "Apple SD Gothic Neo", "Noto Sans KR", Helvetica, Arial, sans-serif;
        font-size: 17px;
        line-height: 1.47;
        letter-spacing: -0.022em;
        -webkit-font-smoothing: antialiased;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
        text-underline-offset: 0.18em;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
      }

      h1 {
        margin: 0;
        font-size: 48px;
        line-height: 1.08;
        font-weight: 600;
        letter-spacing: -0.003em;
      }

      /* Eyebrow: service and version above titles. */
      [data-field="service"],
      [data-field="version"] {
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--muted);
      }

      [data-field="service"] + [data-field="version"]::before {
        content: "·";
        margin: 0 0.5em;
        color: var(--faint);
      }

      time {
        font-size: 14px;
        color: var(--muted);
        letter-spacing: -0.01em;
      }

      /* SCR-101: list */

      [data-el="EL-100"] {
        margin: 28px 0 0;
        border-bottom: 1px solid var(--rule);
      }

      [data-el="EL-100"] ul {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 28px;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      [data-el="EL-100"] a {
        display: inline-block;
        padding: 12px 0;
        margin-bottom: -1px;
        border-bottom: 1px solid transparent;
        font-size: 14px;
        color: var(--muted);
      }

      [data-el="EL-100"] a:hover {
        color: var(--ink);
        text-decoration: none;
      }

      [data-el="EL-100"] a[aria-current="page"] {
        color: var(--ink);
        border-bottom-color: var(--ink);
      }

      [data-el="EL-101"] {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      [data-el="EL-101"] [data-entry] {
        padding: 36px 0 34px;
        border-bottom: 1px solid var(--rule);
      }

      [data-el="EL-101"] [data-entry] > a {
        display: block;
        max-width: 760px;
      }

      [data-el="EL-101"] [data-entry] > a:hover {
        text-decoration: none;
      }

      [data-el="EL-101"] [data-entry] > a:hover [data-field="title"] {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.16em;
      }

      [data-el="EL-101"] [data-field="title"] {
        display: block;
        margin-top: 8px;
        font-size: 28px;
        line-height: 1.14;
        font-weight: 600;
        letter-spacing: 0.002em;
      }

      [data-el="EL-101"] [data-field="summary"] {
        max-width: 760px;
        margin: 12px 0 14px;
        color: var(--muted);
      }

      [data-el="EL-101-empty"] {
        margin: 64px 0;
        color: var(--muted);
      }

      [data-el="EL-102"] ol {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 48px 0 0;
        padding: 0;
        list-style: none;
      }

      [data-el="EL-102"] a {
        display: inline-block;
        min-width: 36px;
        padding: 6px 10px;
        border-radius: 999px;
        text-align: center;
        font-size: 14px;
        color: var(--muted);
      }

      [data-el="EL-102"] a:hover {
        color: var(--ink);
        background: var(--wash);
        text-decoration: none;
      }

      [data-el="EL-102"] a[aria-current="page"] {
        color: var(--paper);
        background: var(--ink);
      }

      /* SCR-102: announcement */

      [data-el="EL-103"],
      [data-el="sns"],
      [data-el="EL-107"] {
        max-width: 692px;
        margin-left: auto;
        margin-right: auto;
      }

      [data-el="EL-103"] h1 {
        font-size: 40px;
        line-height: 1.1;
        font-weight: 700;
      }

      [data-el="EL-103"] > p {
        margin: 12px 0 0;
      }

      [data-el="EL-103"] time + span {
        margin-left: 14px;
        padding-left: 14px;
        border-left: 1px solid var(--rule);
        font-size: 14px;
        color: var(--muted);
      }

      [data-el="EL-103"] [data-field="summary"] {
        margin: 32px 0 0;
        padding-bottom: 32px;
        border-bottom: 1px solid var(--rule);
        font-size: 21px;
        line-height: 1.38;
        font-weight: 600;
        letter-spacing: 0.011em;
      }

      [data-field="body"] {
        margin-top: 32px;
        line-height: 1.6;
      }

      [data-field="body"] > :first-child {
        margin-top: 0;
      }

      [data-field="body"] p,
      [data-field="body"] ul,
      [data-field="body"] ol {
        margin: 0 0 1.2em;
      }

      [data-field="body"] ul,
      [data-field="body"] ol {
        padding-left: 1.3em;
      }

      [data-field="body"] li + li {
        margin-top: 0.4em;
      }

      [data-field="body"] h2,
      [data-field="body"] h3 {
        margin: 2em 0 0.6em;
        font-size: 24px;
        line-height: 1.17;
        font-weight: 600;
      }

      [data-field="body"] h3 {
        font-size: 19px;
      }

      [data-field="body"] a {
        text-decoration: underline;
        text-decoration-color: var(--faint);
        text-underline-offset: 0.18em;
      }

      [data-field="body"] a:hover {
        text-decoration-color: var(--ink);
      }

      [data-field="body"] code {
        padding: 0.1em 0.35em;
        border-radius: 4px;
        background: var(--wash);
        font-family: "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.88em;
      }

      [data-field="body"] blockquote {
        margin: 1.6em 0;
        padding-left: 18px;
        border-left: 2px solid var(--rule);
        color: var(--muted);
      }

      [data-field="body"] hr {
        margin: 2.4em 0;
        border: 0;
        border-top: 1px solid var(--rule);
      }

      [data-el="sns"] {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 48px;
        padding-top: 28px;
        border-top: 1px solid var(--rule);
      }

      [data-el="sns"] a,
      [data-el="sns"] button {
        display: inline-block;
        padding: 7px 16px;
        border: 1px solid var(--rule);
        border-radius: 999px;
        background: var(--paper);
        color: var(--ink);
        font: inherit;
        font-size: 14px;
        letter-spacing: -0.01em;
        cursor: pointer;
      }

      [data-el="sns"] a:hover,
      [data-el="sns"] button:hover {
        border-color: var(--ink);
        text-decoration: none;
      }

      [data-el="EL-107"] {
        display: block;
        margin-top: 40px;
        font-size: 14px;
        color: var(--muted);
      }

      [data-el="EL-107"]:hover {
        color: var(--ink);
      }

      @media (max-width: 734px) {
        body {
          padding: 44px 16px 88px;
        }

        h1 {
          font-size: 34px;
        }

        [data-el="EL-103"] h1 {
          font-size: 30px;
        }

        [data-el="EL-101"] [data-field="title"] {
          font-size: 22px;
        }

        [data-el="EL-103"] [data-field="summary"] {
          font-size: 19px;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>

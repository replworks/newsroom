---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import {
  copyText,
  detailPath,
  linkedInShareUrl,
  slugOf,
  xIntentUrl,
} from "../../../lib/announcements.ts";
import { loadAnnouncements, toAnnouncement } from "../../../lib/content.ts";

export const getStaticPaths = (async () => {
  const entries = await loadAnnouncements();
  return entries.map((entry) => ({
    params: { slug: slugOf(entry), version: entry.data.version },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const { title, service, version, date, corrected, summary } = entry.data;
const url = new URL(detailPath(base, toAnnouncement(entry)), Astro.site).href;
const snsX = entry.data.sns?.x ?? "";
const snsLinkedIn = entry.data.sns?.linkedin ?? "";
// EL-106: one copy button per non-empty SNS text (placeholder labels; copy is human-owned).
const copies = [
  { channel: "x", label: "Copy X text", text: snsX },
  { channel: "linkedin", label: "Copy LinkedIn text", text: snsLinkedIn },
].filter((copy) => copy.text !== "");
---

<Base title={title} og={{ title, description: summary, url }}>
  <a data-el="EL-108" href={base}>
    ‹ All announcements
  </a>
  <article data-el="EL-103">
    <h1 data-field="title">{title}</h1>
    <p>
      <span data-field="service">{service}</span>
      <span data-field="version">{version}</span>
    </p>
    <p>
      <time data-field="date" datetime={date}>
        {date.slice(0, 10)}
      </time>
      {corrected && (
        <span>
          Corrected:{" "}
          <time data-field="corrected" datetime={corrected}>
            {corrected}
          </time>
        </span>
      )}
    </p>
    <p data-field="summary">{summary}</p>
    <div data-field="body">
      <Content />
    </div>
  </article>
  {(snsX !== "" || snsLinkedIn !== "") && (
    <div data-el="sns">
      {snsX !== "" && (
        <a
          data-el="EL-104"
          href={xIntentUrl(snsX, url)}
          target="_blank"
          rel="noopener noreferrer"
        >
          Share on X
        </a>
      )}
      {snsLinkedIn !== "" && (
        <a
          data-el="EL-105"
          href={linkedInShareUrl(url)}
          target="_blank"
          rel="noopener noreferrer"
        >
          Share on LinkedIn
        </a>
      )}
      {copies.map((copy) => (
        <button
          type="button"
          data-el="EL-106"
          data-channel={copy.channel}
          data-copy={copyText(copy.text, url)}
        >
          {copy.label}
        </button>
      ))}
    </div>
  )}
  <a data-el="EL-107" href={base}>
    All announcements
  </a>
</Base>

<script>
  // EL-106: copy the SNS text and the announcement URL, then confirm on the button.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-el="EL-106"]',
  )) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
      button.textContent = "Copied";
    });
  }
</script>

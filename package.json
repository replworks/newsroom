{
  "name": "newsroom",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "astro build",
    "build:fixtures": "NEWSROOM_ANNOUNCEMENTS_DIR=tests/fixtures/announcements NEWSROOM_OUT_DIR=./dist-fixture astro build && NEWSROOM_ANNOUNCEMENTS_DIR=tests/fixtures/none NEWSROOM_OUT_DIR=./dist-empty astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:e2e": "pnpm build:fixtures && playwright test",
    "test:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "astro": "^7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@astrojs/astro2tsx@0.1.3": {
        "dependencies": {
          "@emnapi/runtime": "1.11.3"
        }
      }
    }
  }
}
